ENVIRONMENT=development
DATABASE_URL=sqlite:///./voicebridge.db
MAX_AUDIO_MB=12

# OFFICIAL N-ATLAS ASR
# Sprint 2C local test: local. Keep pending until ready to download/load the model.
# api remains available if NAIC/NCAIR supplies a hosted service.
NATLAS_ASR_MODE=local
NATLAS_ASR_DEVICE=auto
NATLAS_ASR_URL=
NATLAS_ASR_API_KEY=
NATLAS_ASR_TIMEOUT_SECONDS=120

# N-ATLAS LLM remains stub during ASR-first integration.
NATLAS_LLM_MODE=stub
NATLAS_LLM_URL=
NATLAS_LLM_API_KEY=
NATLAS_MODEL_NAME=NCAIR1/N-ATLaS
NATLAS_HF_TOKEN=
NATLAS_LOCAL_DEVICE=auto
NATLAS_LOCAL_DTYPE=auto
NATLAS_MAX_NEW_TOKENS=280
NATLAS_TEMPERATURE=0.1
NATLAS_REQUEST_TIMEOUT_SECONDS=120
